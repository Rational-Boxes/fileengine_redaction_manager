# redaction_manager — on the BACKUP account. No deployment credentials belong here.

# Loopback only. This must not be reachable off-host.
RM_HOST=127.0.0.1
RM_PORT=8105

# What it may touch, named explicitly so the blast radius is readable.
RM_CONTENT_BUCKET=
RM_META_BUCKET=
RM_REGION=

# An administrator credential for the backup account. Export it for the
# operation; do not leave it here afterwards.
RM_AWS_ACCESS_KEY_ID=
RM_AWS_SECRET_ACCESS_KEY=

# A normal redaction is a handful of files; thousands is an attack or a bug.
RM_MAX_OBJECTS=50
# Cooling period. A statutory deadline is typically a month, so a week is free.
RM_HOLD_DAYS=7
