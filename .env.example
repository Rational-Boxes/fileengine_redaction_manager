# redaction_manager — on the BACKUP account. No deployment credentials belong here.

# Two shapes, and the choice is explicit. Loopback (default) means the operator
# reaches it over an SSH tunnel and it is not on the network at all. Binding an
# interface requires RM_ALLOWED_IPS, and the deployment refuses the combination
# of off-loopback with no allowlist.
RM_HOST=127.0.0.1
RM_PORT=8105

# Administrator addresses, as CIDRs. The firewall is the enforcement; the
# application checks the socket peer as a second line, never a forwarded header.
RM_ALLOWED_IPS=

# What it may touch, named explicitly so the blast radius is readable.
RM_CONTENT_BUCKET=
RM_META_BUCKET=
RM_REGION=

# An administrator credential for the backup account. Export it for the
# operation; do not leave it here afterwards.
RM_AWS_ACCESS_KEY_ID=
RM_AWS_SECRET_ACCESS_KEY=

# A normal redaction is a handful of files; thousands is an attack or a bug.
RM_MAX_OBJECTS=50
# Cooling period. A statutory deadline is typically a month, so a week is free.
RM_HOLD_DAYS=7
